# ─── Server ───────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=12h

# Liquidity provider: sandbox | mt5 | ctrader
LIQUIDITY_MODE=sandbox

# MT5 white-label (PrimeXM / Fortex / manager API)
MT5_ENDPOINT=
MT5_MANAGER_LOGIN=
MT5_MANAGER_PASSWORD=
MT5_SERVER=

# cTrader Open API
CTRADER_ENDPOINT=
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=

# ─── Sumsub KYC/AML ────────────────────────────────────────────────────────
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_SANDBOX=true
SUMSUB_WEBHOOK_SECRET=

# ─── Compliance ─────────────────────────────────────────────────────────────
# Countries blocked from onboarding (comma, ISO-2). US/CA often restricted for CFDs.
BLOCKED_COUNTRIES=US,CA,IR,KP,SY
# Per-jurisdiction max leverage (regulatory tiers)
LEVERAGE_TIERS={"DEFAULT":30,"EU":30,"UK":30,"AU":30,"ROW":500}
AML_ENABLED=false
AML_API_KEY=

# Virtual starting balance (sandbox demo funds, NO real money)
SANDBOX_BALANCE=100000
